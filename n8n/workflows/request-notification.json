                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "loan.cancelled",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "cancelled"
            }
          ]
        }
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000005",
      "name": "Switch by Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst messages = {\n  'loan.requested': `Hi ${item.recipientName}, someone requested to borrow \"${item.toolName}\" from ${item.startDate} to ${item.endDate}.`,\n  'loan.approved': `Good news ${item.recipientName}! Your request to borrow \"${item.toolName}\" (${item.startDate} -> ${item.endDate}) was approved.`,\n  'loan.declined': `Hi ${item.recipientName}, your request to borrow \"${item.toolName}\" (${item.startDate} -> ${item.endDate}) was declined.`,\n  'loan.returned': `Hi ${item.recipientName}, \"${item.toolName}\" has been marked as returned. Thank you!`,\n  'loan.cancelled': `Hi ${item.recipientName}, the borrow request for \"${item.toolName}\" (${item.startDate} -> ${item.endDate}) was cancelled.`\n};\n\nconst subject = `[LendLoop] ${item.type} - ${item.toolName}`;\nconst text = messages[item.type] || `Update on loan ${item.loanId} for ${item.toolName}`;\n\nconsole.log(JSON.stringify({\n  channel: 'notification_dispatch',\n  eventId: item.eventId,\n  to: item.recipientEmail,\n  subject,\n  text\n}));\n\nreturn [{ json: { ...item, subject, text, dispatchedAt: new Date().toISOString() } }];"
      },
      "id": "e1a2b3c4-0001-4000-8000-000000000006",
      "name": "Send Notification (Retry Enabled)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
