# =============================================================================
# LendLoop Environment Variables Example
# Copy this file to .env.local for Next.js and configure Convex / n8n variables.
# NEVER commit real secrets to the repository.
# =============================================================================

# --- Next.js & Convex Client ---
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk Authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER_DOMAIN=

# --- Convex Backend Environment Variables (set via `npx convex env set`) ---
# Comma-separated list of admin email addresses (e.g., admin@example.com,owner@example.com)
ADMIN_EMAILS=

# Webhook URL for n8n Flow 1 (Request Notification)
N8N_WEBHOOK_URL=

# Shared HMAC-SHA256 secrets (use distinct 32+ byte random hex strings per direction)
# Outbound: Convex signs -> n8n verifies
N8N_OUTBOUND_SECRET=
# Inbound: n8n signs -> Convex verifies
N8N_INBOUND_SECRET=

